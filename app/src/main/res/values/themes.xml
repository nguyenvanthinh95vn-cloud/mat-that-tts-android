<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MatThatTTS" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/matthat_red</item>
        <item name="colorPrimaryDark">@color/matthat_red_dark</item>
        <item name="colorAccent">@color/matthat_gold</item>
        <item name="android:windowBackground">@color/matthat_bg</item>
    </style>

    <style name="MatThat.Button.Primary" parent="Widget.AppCompat.Button.Colored">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="MatThat.Button.Tab" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
